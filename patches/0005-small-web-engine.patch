@@ -0,0 +1,25 @@
+# My Dictator Stalin Can't Be This Cute — Godot 4.7.1 Web release template.
+platform = "web"
+target = "template_release"
+optimize = "size_extra"
+lto = "full"
+debug_symbols = False
+deprecated = True
+minizip = False
+disable_3d = True
+disable_physics_2d = True
+disable_navigation_2d = True
+modules_enabled_by_default = False
+module_freetype_enabled = True
+module_gdscript_enabled = True
+module_jpg_enabled = True
+module_mbedtls_enabled = True
+module_mp3_enabled = True
+module_msdfgen_enabled = False
+module_ogg_enabled = False
+module_regex_enabled = True
+module_svg_enabled = True
+module_text_server_adv_enabled = False
+module_text_server_fb_enabled = True
+module_vorbis_enabled = False
+module_webp_enabled = True
